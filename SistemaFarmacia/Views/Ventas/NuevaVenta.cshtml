@{
    ViewData["Title"] = "Nueva Venta";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h2>Nueva Venta</h2>

<form asp-action="AgregarProducto" method="post">

    <div class="form-group">
        <label>Producto</label>
        <select name="ProductoId" class="form-control" asp-items="ViewBag.Productos"></select>
    </div>

    <div class="form-group">
        <label>Cantidad</label>
        <input type="number" name="Cantidad" class="form-control" />
    </div>

    <br />

    <button class="btn btn-primary">Agregar al carrito</button>

</form>
<h3>Carrito</h3>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Subtotal</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < ((List<ItemVenta>)ViewBag.Carrito).Count; i++)
        {
            var item = ((List<ItemVenta>)ViewBag.Carrito)[i];
            <tr>
                <td>@item.Nombre</td>
                <td>
                    <form asp-action="EditarCantidad" method="post" style="display:flex;">
                        <input type="hidden" name="index" value="@i" />
                        <input type="number" name="nuevaCantidad" value="@item.Cantidad" class="form-control" style="width:80px;" />
                        <button class="btn btn-warning btn-sm">Actualizar</button>
                    </form>
                </td>
                <td>@item.Precio.ToString("N2")</td>
                <td>@item.Subtotal.ToString("N2")</td>
                <td>
                    <form asp-action="EliminarProducto" method="post">
                        <input type="hidden" name="index" value="@i" />
                        <button class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar producto?')">
                            Eliminar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<h4>Total: ₡ @ViewBag.Total.ToString("N2")</h4>
<form asp-action="FinalizarVenta" method="post">
    <button class="btn btn-success">Finalizar Venta</button>
</form>